#!/usr/bin/env bash

# Alguns hosts entregam o container com umask 0000 (n8n.embrapa.io, set/2026):
# arquivos nasciam com modo 666 e o OpenSSH recusava o ~/.ssh/config
# ("Bad owner or permissions"), derrubando o clone de todo deploy.
umask 022

# Cores ANSI discretas só em terminal (e sem NO_COLOR): saída redirecionada ou
# capturada por script fica em texto puro. A largura do terminal vai para o
# run.php em COLUMNS (o menu quebra as descrições por ela).
if [ -t 1 ] && [ -z "$NO_COLOR" ] && [ "$TERM" != "dumb" ]; then
  B=$'\e[1m'; D=$'\e[2m'; G=$'\e[32m'; Y=$'\e[33m'; R=$'\e[31m'; N=$'\e[0m'

  cols=$(tput cols 2> /dev/null || stty size 2> /dev/null | cut -d' ' -f2)

  [[ $cols =~ ^[0-9]+$ ]] && export COLUMNS=$cols
else
  B=''; D=''; G=''; Y=''; R=''; N=''
fi

# Cabeçalho com a logo ("I/O" na fonte "small" do FIGlet), igual ao do menu (class/Menu.php).
banner() {
  echo ""
  echo " ${G} ___    __  ___  ${N}  ${B}Embrapa I/O Releaser${N}"
  echo " ${G}|_ _|  / / / _ \\ ${N}  Version ${IO_RELEASER_VERSION:-dev}"
  echo " ${G} | |  / / | (_) |${N}  A command line utility to deploy and update apps"
  echo " ${G}|___|/_/   \\___/ ${N}  ${D}https://embrapa.io/docs/releaser/${N}"
}

# Na configuração inicial, o cabeçalho completo (e o run.php não o repete); sem
# comando, o run.php imprime o menu com o cabeçalho; com comando, só uma linha.
if [ ! -d "/data" ] || [ ! -f "/data/.env" ]; then
  banner

  export IO_BANNER=shown
elif [ $# -gt 0 ]; then
  echo ""
  echo "${D}Embrapa I/O Releaser ${IO_RELEASER_VERSION:-dev} · https://embrapa.io/docs/releaser/${N}"
fi

if [ ! -d "/data" ]; then
  echo ""

  echo "${R}Critical!${N} You need to mount volume data! Correct command to use this image is:"
  echo ""
  echo "docker run --name releaser -v \$(pwd):/data -v /var/run/docker.sock:/var/run/docker.sock --restart unless-stopped -d embrapa/releaser"

  exit 1
fi

if [ ! -f "/data/.env" ]; then
  while
    echo ""

    echo "${Y}Warning!${N} Environment variables file (.env) not found!"
    echo "Please, enter with required info..."

    echo ""

    while
      read -p "${B}Server name${N} (e.g., foo.example.com): " server
      [[ -z $server || $server =~ [^a-z0-9-\.] ]]
    do true; done

    echo ""

    echo "${B}Container orchestrator${N}"

    orchestrators=(DockerCompose DockerSwarm)
    labels=("DockerCompose  (one server, Docker Compose)" "DockerSwarm    (Docker Swarm cluster)")

    while
      PS3="Choose 1 or 2: "

      select label in "${labels[@]}"
      do
        orchestrator=${orchestrators[$((REPLY - 1))]:-}
        break
      done
      [[ -z $orchestrator || $orchestrator != @(DockerCompose|DockerSwarm) ]]
    do true; done

    echo ""

    echo "Go to https://git.embrapa.io and, in your profile, generate a new"
    echo "Access Token with the 'read_api' scope."

    while
      read -p "${B}GitLab token${N}: " token
      [[ -z $token || ${#token} < 10 ]]
    do true; done

    echo ""

    while
      read -p "${B}SMTP host${N} (e.g., smtp.gmail.com): " smtp_host
      [[ -z $smtp_host || $smtp_host =~ [^a-z0-9-\.] ]]
    do true; done

    while
      read -p "${B}SMTP port${N} (e.g., 587): " smtp_port
      [[ -z $smtp_port || $smtp_port == *[^0-9]* ]]
    do true; done

    read -p "${B}SMTP secure${N} (y/N): " smtp_secure

    if [ "$smtp_secure" != "${smtp_secure#[Yy]}" ]; then
      smtp_secure="yes"
    else
      smtp_secure="no"
    fi

    while
      read -p "${B}SMTP from${N} (e.g., no-reply@embrapa.br): " smtp_from
      [[ -z $smtp_from || $smtp_from =~ [^a-zA-Z0-9,-@\.] ]]
    do true; done

    read -p "${B}SMTP user${N} (e.g., you@gmail.com): " smtp_user
    read -p "${B}SMTP password${N}: " smtp_pass

    echo ""

    while
      read -p "${B}e-Mail to log${N}: " email
      [[ -z $email || $email =~ [^a-zA-Z0-9,-@\.] ]]
    do true; done

    echo ""

    echo "Please check the value of each configuration variable and confirm:"

    echo ""

    out="SERVER=${server//[[:space:]]/}"$'\n'
    out+="ORCHESTRATOR=$orchestrator"$'\n'
    out+="GITLAB_TOKEN=${token//[[:space:]]/}"$'\n'
    out+="SMTP_HOST=${smtp_host//[[:space:]]/}"$'\n'
    out+="SMTP_PORT=${smtp_port//[^0-9]/}"$'\n'
    out+="SMTP_SECURE=$smtp_secure"$'\n'
    out+="SMTP_FROM=${smtp_from//[[:space:]]/}"$'\n'
    out+="SMTP_USER=${smtp_user//[[:space:]]/}"$'\n'
    out+="SMTP_PASS=${smtp_pass//[[:space:]]/}"$'\n'
    out+="LOG_MAIL=${email//[[:space:]]/}"

    echo "$out"

    echo ""

    read -p "${B}Is correct?${N} (y/N): " confirm

    [[ -z $confirm || "$confirm" == "${confirm#[Yy]}" ]]
  do true; done

  echo "$out" > /data/.env

  echo ""

  echo "Note: A '.env' file has been created in volume directory shared with the container. To change values in the future, edit this file."
fi

export $(cat /data/.env)

if [ ! -f "/root/.ssh/id_rsa" ]; then
  echo ""

  echo "${Y}Warning!${N} Looks like the SSH Key to GitLab access is missing."

  echo ""

  if [ ! -f "/data/ssh" ]; then
    echo "Generating new SSH key pair..."

    ssh-keygen -o -t rsa -b 4096 -N '' -C '' -f /data/ssh
  else
    echo "An SSH private key already exists in the volume directory shared with the container. This key will be restored."
  fi

  if [ ! -f "/data/ssh.pub" ]; then
    echo "Generating a new SSH public key from private key..."

    ssh-keygen -y -f /data/ssh > /data/ssh.pub
  fi

  echo ""

  echo "Configuring SSH private key in container environment..."

  mkdir -p /root/.ssh
  cp /data/ssh /root/.ssh/id_rsa
  chmod 600 /root/.ssh/id_rsa
  ssh-add /root/.ssh/id_rsa
  echo -e "Host *\n\tStrictHostKeyChecking no\n\n" > ~/.ssh/config

  echo ""

  echo "${G}Done!${N} Please, access GitLab (https://git.embrapa.io) and, in your profile,"
  echo "add a new SSH key with the following content:"

  echo ""

  cat /data/ssh.pub

  echo ""

  echo "Note: SSH key pair is available on the volume directory shared with the container."
fi

# Autocorreção a cada execução: containers criados com umask 0000 por versões
# anteriores ficaram com ~/.ssh/config em 666, que o OpenSSH recusa.
chmod 700 /root/.ssh 2> /dev/null
chmod 600 /root/.ssh/config /root/.ssh/id_rsa 2> /dev/null

if [ ! -f "/data/builds.json" ] && [ ! -d "/data/builds" ]; then
  echo ""

  echo "${Y}Warning!${N} The builds are not configured yet (directory 'builds/' is missing)."

  echo ""

  echo "Please enter some builds comma separated, e.g.:"
  echo "project-a/app1@beta,project-b/web@release,project-a/app2@alpha"

  echo ""

  while
    read -p "${B}Builds${N}: " input
    [[ -z $input || $input =~ [^a-z0-9,-/@\ ] ]]
  do true; done

  builds=$(echo $input | tr "," "\n")

  count=0
  unset array

  sentry=$(jq -n \
    --arg dsn "" \
    '$ARGS.named')

  matomo=$(jq -n \
    --argjson id 0 \
    --arg token "" \
    '$ARGS.named')

  auto=$(jq -n \
    --argjson deploy true \
    --argjson backup true \
    --argjson sanitize true \
    --argjson cleaner false \
    '$ARGS.named')

  # O que a build reporta ao core (versão, saúde e CVEs): tudo ligado por padrão.
  stats=$(jq -n \
    --argjson version true \
    --argjson cve true \
    --argjson health true \
    '$ARGS.named')

  mkdir -p /data/builds

  for build in $builds
  do
    if [[ ! $build =~ [[:space:]]*([a-z0-9][a-z0-9-]+[a-z0-9])\/([a-z0-9][a-z0-9-]+[a-z0-9])@((alpha)|(beta)|(release))[[:space:]]* ]]; then
      echo "The build format for '$build' is incorrect! It will be ignored."

      continue
    fi

    # um arquivo por build: /data/builds/<projeto>_<app>_<estágio>.json
    jq -n \
      --arg project ${BASH_REMATCH[1]} \
      --arg app ${BASH_REMATCH[2]} \
      --arg stage ${BASH_REMATCH[3]} \
      --argjson team "[]" \
      --argjson sentry "$sentry" \
      --argjson matomo "$matomo" \
      --argjson auto "$auto" \
      --argjson stats "$stats" \
      --argjson env "{}" \
      '$ARGS.named' > "/data/builds/${BASH_REMATCH[1]}_${BASH_REMATCH[2]}_${BASH_REMATCH[3]}.json"

    ((count++))
  done

  if (( count == 0 )); then
    echo "${Y}Warning!${N} No one build could be configured. Try again or run 'io install' for a guided setup."

    exit 1
  fi

  echo "${G}Done!${N} $count build file(s) created in 'builds/' inside the volume directory"
  echo "shared with the container. Now, complete each file with the e-mails of your"
  echo "team members, the Sentry DSN, the Matomo ID/token and the environment"
  echo "variables ('env')."
  echo ""
  echo "${D}Tip: 'io install' does all of that for you, guided, fetching from the platform"
  echo "what only the platform knows.${N}"
fi

echo ""

/usr/local/bin/php /app/run.php "${@:1}"

echo $'\n'
